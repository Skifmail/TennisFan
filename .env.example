# Django settings
# В Dokploy: если в ключе есть символ $, пишите $$ (иначе $буквы воспринимаются как переменная)
SECRET_KEY=your-secret-key-here
DEBUG=False
# Локальная отладка: LOG_TO_CONSOLE=True выводит логи в терминал (Django + loguru)
# LOG_TO_CONSOLE=True
# LOG_LEVEL=DEBUG
ALLOWED_HOSTS=tennisfan.ru,www.tennisfan.ru
CSRF_TRUSTED_ORIGINS=https://tennisfan.ru,https://www.tennisfan.ru

# OneSignal Web Push: публичный App ID, не секретный API-ключ.
# Пустой ONESIGNAL_APP_ID отключает SDK. Origin должен совпадать с Site URL в OneSignal.
ONESIGNAL_APP_ID=c6e46e19-f9f8-4df3-b53d-44f49da24af2
ONESIGNAL_SITE_ORIGIN=https://tennisfan.ru
# Обновлять сессию при каждом запросе (рекомендуется для админки на мобильных)
# SESSION_SAVE_EVERY_REQUEST=True
# Доп. домены для бренда TennisTop в шапке/футере (через запятую). Пусто — только tennistop.ru и www.tennistop.ru.
# TENNISTOP_EXTRA_HOSTS=staging.tennistop.ru
# Путь к админ-панели (по умолчанию admin). Для усиления безопасности задайте свой, напр. ADMIN_URL=manage-xyz
# ADMIN_URL=admin
# Первый админ (только при первом деплое, если суперпользователей ещё нет). Вход в админку — по email. После входа можно удалить из Environment.
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=secure-password

# PostgreSQL Database
USE_POSTGRES=True
POSTGRES_DB=tennisfan
POSTGRES_USER=tennisfan
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Telegram: включить сеть только после заполнения реальных настроек.
TELEGRAM_ENABLED=False
# Исходящий бот админских уведомлений — отдельный от пользовательского бота.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Бот ЛК: токен и секрет обязательны для работающего webhook.
TELEGRAM_USER_BOT_TOKEN=
# Username без @ позволяет не запрашивать getMe при открытии профиля.
TELEGRAM_USER_BOT_USERNAME=
# Случайный секрет: 1–256 символов A-Z, a-z, 0-9, _ и -; рекомендуется 32+.
# Секреты задавать приватно, не в аргументах команд и не в репозитории.
TELEGRAM_USER_BOT_WEBHOOK_SECRET=
TELEGRAM_BOT_SITE_BASE_URL=https://tennisfan.ru
# При недоступности API можно задать http(s)/socks5-прокси только для Telegram.
TELEGRAM_API_PROXY_URL=
# Публичная ссылка на открытое сообщество (иконка ТГ в футере ведёт сюда)
TELEGRAM_PUBLIC_COMMUNITY_URL=https://t.me/TennisFanu
# Закрытый чат подписчиков выключен до настройки ДВУХ разных отрицательных ID
# открытого и закрытого чатов и прав бота на приглашения/заявки/удаление.
TELEGRAM_PRIVATE_CHAT_ACCESS_ENABLED=False
TELEGRAM_PUBLIC_COMMUNITY_CHAT_ID=
TELEGRAM_PRIVATE_COMMUNITY_CHAT_ID=
# Поддержка и оспаривание результата — /support/ на сайте; старый support-webhook не используется.

# ЮKassa (приём платежей: донаты, подписки, турниры)
# https://yookassa.ru/developers/payment-acceptance/getting-started/quick-start
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Yandex Maps API
YANDEX_MAPS_API_KEY=your-yandex-maps-api-key
YANDEX_GEOCODER_API_KEY=your-yandex-geocoder-api-key
YANDEX_GEOCODER_REFERER=https://tennisfan.ru

# Email settings (SpaceWeb SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.spaceweb.ru
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=tennis@tennisfan.ru
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=tennis@tennisfan.ru
USER_NOTIFICATIONS_EMAIL_ENABLED=True
ADMIN_NOTIFICATIONS_EMAIL=admin@tennisfan.ru
STRINGER_APPLICATION_NOTIFICATION_EMAIL=admin@tennisfan.ru
COURT_APPLICATION_NOTIFICATION_EMAIL=admin@tennisfan.ru

# S3 Storage (SpaceWeb / Reg.ru Cloud)
USE_S3=True
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=tennisfan
S3_ENDPOINT_URL=https://s3.regru.cloud
S3_REGION=ru-1

# Поисковики: верификация (Google Search Console, Yandex Webmaster)
# Коды из интерфейсов верификации — вставляются в <meta> на сайте
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# YANDEX_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxx
# Домен для sitemap.xml (по умолчанию tennisfan.ru)
# SITE_DOMAIN=tennisfan.ru

# Яндекс.Метрика: ID счётчика (число). Пусто или 0 — счётчик не подключается.
# Загружается только после согласия пользователя на cookie.
YANDEX_METRIKA_ID=107284748

# Городские чаты. URL отдельного Redis для Channels (не публичный порт).
# В Docker Compose значение по умолчанию уже задано; для локального запуска:
# CHAT_REDIS_URL=redis://127.0.0.1:6379/0

# Проверки готовности Docker настраиваются в Compose.
# HEALTHCHECK_CHAT_REDIS=True задаётся только ASGI-сервису chat.
# HTTP остаётся доступным, если временно недоступен транспорт WebSocket.

# Центр персональных уведомлений: включить только после миграций и проверки подтверждения подписки.
NOTIFICATION_CENTER_ENABLED=False
# Приглашение на главной включается отдельно после проверки подключения на iPhone.
NOTIFICATION_PROMPT_ENABLED=False
ONESIGNAL_REST_API_KEY=

# Социальный вход. Секреты задаются только в окружении сервера.
SOCIAL_YANDEX_ENABLED=False
SOCIAL_YANDEX_CLIENT_ID=
SOCIAL_YANDEX_CLIENT_SECRET=
SOCIAL_YANDEX_REDIRECT_URI=https://tennisfan.ru/users/social/yandex/callback/
SOCIAL_VK_ENABLED=False
SOCIAL_VK_CLIENT_ID=
SOCIAL_VK_CLIENT_SECRET=
SOCIAL_VK_REDIRECT_URI=https://tennisfan.ru/users/social/vk/callback/

# Детская лига доступна публично; онлайн-оплата включается отдельно.
JUNIOR_PAYMENTS_ENABLED=False
